# ==============================================================================
# NovaData KKB - Environment Configuration Template
# ==============================================================================
# Bu dosya şablon niteliğindedir. Gerçek anahtarlarınızı buraya yazmayın.
# Kullanım için bu dosyayı '.env' adıyla kopyalayıp ilgili değerleri doldurunuz.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TCMB EVDS (Elektronik Veri Dağıtım Sistemi)
# ------------------------------------------------------------------------------
# Varsayılan / Birincil Anahtar
EVDS_API_KEY=your_primary_evds_api_key

# Anahtar Havuzu (Key Rotation & Fallback Pool)
EVDS_API_KEY_1=your_evds_key_1
EVDS_API_KEY_2=your_evds_key_2
EVDS_API_KEY_3=your_evds_key_3
EVDS_API_KEY_4=your_evds_key_4

# EVDS Servis URL'i
EVDS_BASE_URL=https://evds2.tcmb.gov.tr/service/evds/

# ------------------------------------------------------------------------------
# 2. Kloudeks LLM & Model Servisi
# ------------------------------------------------------------------------------
MIA_API_KEY=
# KLOUDEKS_BASE_URL=https://api.kloudeks.com/v1
# KLOUDEKS_DEFAULT_MODEL=

# ------------------------------------------------------------------------------
# 3. Veritabanı & Depolama Yapılandırması
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/kkb.db
# DUCKDB_PATH=./data/lakehouse.duckdb

# ------------------------------------------------------------------------------
# 4. Uygulama Genel Ayarları
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=True
LOG_LEVEL=INFO

# Derin analizler uzun sürebilir (mentör direktifi). Saniye cinsinden.
REQUEST_HARD_TIMEOUT_SECONDS=900
# Ajanın tek soruda atabileceği maksimum tool adımı
AGENT_MAX_ITERATIONS=12

# ------------------------------------------------------------------------------
# 5. Frontend & Authentication (NextAuth)
# ------------------------------------------------------------------------------
# Google login iin kullanlacak OAuth 2.0 kimlik bilgileri
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=your_random_secret_string_here
NEXTAUTH_URL=http://localhost:3000

# Frontend'in backend'e eriştiği adres (deploy'da public URL yazılmalı)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
